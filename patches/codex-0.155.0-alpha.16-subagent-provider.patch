+#[tokio::test]
+async fn apply_role_allows_only_the_pinned_glm_worker_provider() {
+    let (home, mut config) = test_config_with_cli_overrides(Vec::new()).await;
+    let mut pinned_provider = config.model_provider.clone();
+    pinned_provider.name = "Pinned GLM worker provider".to_string();
+    config.model_providers.insert(
+        PINNED_SUBAGENT_MODEL_PROVIDER_ID.to_string(),
+        pinned_provider.clone(),
+    );
+    let role_path = write_role_config(
+        &home,
+        "glm-worker.toml",
+        r#"developer_instructions = "Stay focused"
+model = "glm-5.3"
+model_provider = "zai_glm_native"
+"#,
+    )
+    .await;
+    config.agent_roles.insert(
+        "glm_worker".to_string(),
+        AgentRoleConfig {
+            description: None,
+            config_file: Some(role_path),
+            nickname_candidates: None,
+        },
+    );
+
+    apply_role_to_config(&mut config, Some("glm_worker"))
+        .await
+        .expect("pinned GLM role should apply");
+
+    assert_eq!(config.model.as_deref(), Some("glm-5.3"));
+    assert_eq!(config.model_provider_id, PINNED_SUBAGENT_MODEL_PROVIDER_ID);
+    assert_eq!(config.model_provider, pinned_provider);
+}
